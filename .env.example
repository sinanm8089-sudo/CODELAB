# CODELAB IDE v2.0 - Environment Configuration Template
# Developer & Product Owner: Sinan Mohammed

# Application Identity
APP_NAME="CODELAB IDE"
DEVELOPER="Sinan Mohammed"
VERSION="2.0.0"

# Database Configuration
# Local SQLite for immediate zero-config dev:
DATABASE_URL="sqlite:///./codeverse.db"
# Production PostgreSQL:
# DATABASE_URL="postgresql://codelab_admin:codelab_secure_pass_2026@localhost:5432/codelab_prod"

# Security & Sessions
JWT_SECRET="generate-a-secure-random-256-bit-key-for-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Whitelist (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,*"

# Execution Sandbox Quotas
MAX_EXECUTION_TIME_SEC=5.0
MAX_CODE_BYTES=65536
MAX_OUTPUT_BYTES=65536

# Google Gemini AI Integration
# Model recommendations: gemini-3.8-flash, gemini-3-flash-preview, gemini-2.5-flash
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3-flash-preview"

# Frontend Public API Target
NEXT_PUBLIC_API_URL="http://localhost:8000"
