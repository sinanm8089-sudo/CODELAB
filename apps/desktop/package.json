{
  "name": "codelab-ide-desktop",
  "version": "2.0.0",
  "description": "CODELAB IDE Universal Desktop Application architected by Sinan Mohammed",
  "main": "main.js",
  "author": "Sinan Mohammed",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.sinanmohammed.codelabide",
    "productName": "CODELAB IDE",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": ["AppImage", "deb"]
    }
  }
}

