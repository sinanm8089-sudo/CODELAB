# CODEVERSE LAB - Isolated Runner Dockerfile
# Developer: Sinan Mohammed
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install complete language runtimes
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    clang \
    python3 \
    python3-pip \
    nodejs \
    openjdk-17-jdk-headless \
    golang-go \
    rustc \
    php-cli \
    ruby \
    sqlite3 \
    bash \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create sandboxed non-root user
RUN useradd -m -s /bin/bash sandbox
USER sandbox
WORKDIR /home/sandbox

CMD ["bash"]

